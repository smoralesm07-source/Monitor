    },
    {
      "rol": "ejecutivo",
      "tipos": [
        "PERSONA"
      ],
      "patron": "\\b(?:gerente|director|directora|ejecutivo|ejecutiva)\\b"
    },
    {
      "rol": "fiscal",
      "tipos": [
        "PERSONA"
      ],
      "patron": "\\bfiscal(?:es)?\\b"
    },
    {
      "rol": "abogado",
      "tipos": [
        "PERSONA"
      ],
      "patron": "\\babogad[oa]s?\\b"
    },
    {
      "rol": "autoridad",
      "tipos": [
        "PERSONA"
      ],
