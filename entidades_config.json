    {
      "rol": "empresa investigada",
      "tipos": [
        "EMPRESA",
        "ORGANIZACION",
        "INSTITUCION_FINANCIERA"
      ],
      "patron": "\\b(?:empresa|sociedad|banco).{0,45}(?:investigad[oa]|indagad[oa]|imputad[oa])\\b|\\b(?:investigad[oa]|indagad[oa]|imputad[oa]).{0,45}(?:empresa|sociedad|banco)\\b"
    },
    {
      "rol": "querellante",
      "tipos": [
        "ORGANISMO_PUBLICO",
        "EMPRESA",
        "ORGANIZACION"
      ],
      "patron": "\\b(?:presentó|interpuso|presenta|interpone).{0,35}querella\\b"
