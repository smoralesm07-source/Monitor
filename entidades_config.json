        "PERSONA",
        "EMPRESA",
        "ORGANIZACION"
      ],
      "patron": "\\bquerellad[oa]s?\\b"
    },
    {
      "rol": "víctima",
      "tipos": [
        "PERSONA",
        "EMPRESA",
        "ORGANIZACION"
      ],
