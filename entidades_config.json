  "patrones": [
    {
      "label": "ORGANISMO_PUBLICO",
      "pattern": [
        {
          "LOWER": "fiscalía"
        },
        {
          "LOWER": "regional"
        },
        {
          "IS_TITLE": true,
          "OP": "+"
        }
      ]
    },
    {
      "label": "EMPRESA",
      "pattern": [
        {
          "LOWER": {
            "IN": [
              "inversiones",
              "comercial",
              "inmobiliaria",
              "sociedad"
            ]
          }
        },
        {
          "IS_TITLE": true,
          "OP": "+"
        },
        {
          "LOWER": {
            "IN": [
              "spa",
              "ltda",
              "eirl"
            ]
          },
          "OP": "?"
        }
      ]
    }
  ],
  "roles": [
    {
      "rol": "investigado",
      "tipos": [
        "PERSONA"
      ],
      "patron": "\\b(?:investigad[oa]|indagad[oa])s?\\b"
